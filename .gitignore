# node dev server (npm install)
node_modules/
# local version snapshots created by scripts/version-save.ps1
versions/
# studio render output (keep deliverables in projects/<slug>/demo/)
projects/*/out/
# raw crawl media and screenshots stay local (the site keeps only the images it uses)
projects/*/intake*/media/
projects/*/intake*/shots/
# browser-automation scratch (throwaway probe scripts; baselines stay tracked)
projects/_eyes/scratch/
# launch-env runtime state (pid tracking + service logs)
.launch/
# named snapshots (tools/snap.mjs) and the local knowledge index
.snapshots/
.knowledge/
# never let a database reach a commit. opencode.db carries account/credential
# tables and the session history, and tools/canonicalize-paths.mjs duplicates it
# into backups/ on every run. The directories above already keep it out of the
# index; this is the deliberate belt, not an accident of layout.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# a store catalog snapshot keeps its JSON; the images live in the site that uses them
projects/*/catalog/img/
projects/*/visual/.refcache/
projects/*/visual/.graded/
projects/*/visual/probe.json
projects/*/visual/free/out/*.png

# build output - 111 MB of assembled site, never committed
_surfaces/
_site/

# Cloudflare Pages functions: the per-deploy config and wrangler state
cloud/*/wrangler.toml
cloud/*/.wrangler/
_deploy/

# AILGEN Lab: the cached catalog pages
cloud/lab/.cache/

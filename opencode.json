{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "CLAUDE.md", "memory/CORE.md"],
  "small_model": "opencode/mimo-v2.6-flash-free",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "node_modules/.bin/playwright-mcp",
        "--browser", "msedge",
        "--headless",
        "--viewport-size", "1440x900",
        "--no-sandbox",
        "--caps", "core,pdf,network"
      ],
      "enabled": true,
      "timeout": 120000
    }
  },
  "share": "disabled",
  "autoupdate": "notify",
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 24000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 6,
    "reserved": 24000
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "task": "allow",
    "doom_loop": "ask",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rm -rf *": "ask",
      "git push*": "ask",
      "git commit*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git checkout*": "ask",
      "git rebase*": "ask",
      "npm publish*": "ask",
      "gh pr merge*": "ask",
      "gh release*": "ask"
    },
    "external_directory": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.config/opencode/auth.json": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "question": "allow"
  },
  "experimental": {
    "continue_loop_on_deny": true
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "CLAUDE.md"],
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 24000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 6,
    "reserved": 24000
  },
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rm -rf *": "ask",
      "git push*": "ask",
      "git commit*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git checkout*": "ask",
      "npm publish*": "ask"
    },
    "external_directory": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/opencode/auth.json": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "question": "allow"
  },
  "experimental": {
    "continue_loop_on_deny": true
  }
}

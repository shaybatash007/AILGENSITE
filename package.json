{
  "name": "ailgensite",
  "version": "1.0.0",
  "private": true,
  "description": "AILGEN studio static site - no build step, serve only",
  "scripts": {
    "dev": "serve -l tcp://127.0.0.1:8000 --no-clipboard .",
    "up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev.ps1",
    "down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\dev-stop.ps1",
    "save": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\version-save.ps1",
    "restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\version-restore.ps1",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\setup.ps1",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\doctor.ps1",
    "resume": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\resume.ps1",
    "handoff": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\handoff.ps1",
    "he": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\he.ps1",
    "web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\he.ps1 -Web",
    "eyes": "node tools/eyes.mjs",
    "eyes:all": "node tools/eyes.mjs --responsive",
    "env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\launch-env.ps1",
    "env:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\launch-env.ps1 -Stop",
    "snap": "node tools/snap.mjs",
    "know": "node tools/knowledge.mjs",
    "super": "node tools/supervisor.mjs",
    "safe": "node tools/safe-exec.mjs",
    "canon:check": "node tools/canonicalize-paths.mjs --check",
    "canon:apply": "node tools/canonicalize-paths.mjs --apply",
    "canon:restore": "node tools/canonicalize-paths.mjs --restore",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\doctor.ps1",
    "test:canon": "node tools/test-canonicalize.mjs",
    "test:mutate": "node tools/test-mutation.mjs",
    "test:plugin": "node tools/test-memory-plugin.mjs",
    "inspect": "node tools/inspect.mjs"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.82",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.64.0-alpha-1789764292000",
    "pngjs": "^7.0.0",
    "serve": "^14.2.6"
  }
}
